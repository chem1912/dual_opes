# Dual-level OPES for the condition of gamma_coor > 1

#d(O-H)
d1: DISTANCE ATOMS=8,10
#d(N-H)
d2: DISTANCE ATOMS=4,10

#d(O-H)-d(N-H)
dd: COMBINE ARG=d1,d2 POWERS=1,1 COEFFICIENTS=1.0,-1.0 PERIODIC=NO

uwall: UPPER_WALLS ARG=dd AT=0.115 KAPPA=104550.0 EXP=2 EPS=1 OFFSET=0    
lwall: LOWER_WALLS ARG=dd AT=-0.115 KAPPA=104550.0 EXP=2 EPS=1 OFFSET=0   

ox: GROUP ATOMS=11-9589:3
hy: GROUP ATOMS=11-9589 REMOVE=ox

CN4: COORDINATION GROUPA=4 GROUPB=hy R_0=0.17
CN8: COORDINATION GROUPA=8 GROUPB=hy R_0=0.17
CN9: COORDINATION GROUPA=9 GROUPB=hy R_0=0.17
CN5: COORDINATION GROUPA=5 GROUPB=ox R_0=0.17 
CN6: COORDINATION GROUPA=6 GROUPB=ox R_0=0.17 
CN10: COORDINATION GROUPA=10 GROUPB=ox R_0=0.17 

opes: OPES_METAD ...
  ARG=dd
  TEMP=300
  PACE=100
  BARRIER=30
   STATE_WFILE=STATE
   STATE_WSTRIDE=2000*5
   STORE_STATES
...
OPES_METAD_SCHEME2_CONVERGENCE_CONVERGENCE_V21 ...
  LABEL=s2ccv21
  ARG=(CN.*)
  TEMP=300
  PACE=100
  BARRIER=30  
  BIASFACTOR=1.5
  NLIST 
  FILE=KERNELS.s2ccv21
  STATE_WFILE=STATE.s2ccv21
  STATE_RFILE=STATE.s2ccv21
  STATE_WSTRIDE=2000*1
  RESTART=NO
  STORE_STATES
... OPES_METAD_SCHEME2_CONVERGENCE_CONVERGENCE_V21

OPES_METAD_SCHEME2_CONVERGENCE_CONVERGENCE_V22 ...
  LABEL=s2ccv22
  ARG=(CN.*)
  TEMP=300
  PACE=100
  BARRIER=30
  BIASFACTOR=1.5
  NLIST 
  FILE=KERNELS.s2ccv22
  STATE_WFILE=STATE.s2ccv22
  STATE_RFILE=STATE.s2ccv22
  STATE_WSTRIDE=2000*1
  RESTART=NO
  STORE_STATES
... OPES_METAD_SCHEME2_CONVERGENCE_CONVERGENCE_V22


FLUSH STRIDE=100
PRINT STRIDE=100 ARG=d1,d2,dd,uwall.bias,lwall.bias,s2ccv21.bias,s2ccv22.bias,s2ccv22.H1,s2ccv22.H0,s2ccv22.deltaH,opes.bias,(CN.*) FILE=colvar