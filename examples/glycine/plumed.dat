#d(O-H)
d1: DISTANCE ATOMS=8,10
#d(N-H)
d2: DISTANCE ATOMS=4,10

#d(O-H)-d(N-H)
dd: COMBINE ARG=d1,d2 POWERS=1,1 COEFFICIENTS=1.0,-1.0 PERIODIC=NO

uwall: UPPER_WALLS ARG=dd AT=0.115 KAPPA=104550.0 EXP=2 EPS=1 OFFSET=0   # 250 kcal/mol/A^2
lwall: LOWER_WALLS ARG=dd AT=-0.115 KAPPA=104550.0 EXP=2 EPS=1 OFFSET=0  # 250 kcal/mol/A^2

ox: GROUP ATOMS=11-9589:3
hy: GROUP ATOMS=11-9589 REMOVE=ox

CN4: COORDINATION GROUPA=4 GROUPB=hy R_0=0.17
CN8: COORDINATION GROUPA=8 GROUPB=hy R_0=0.17
CN9: COORDINATION GROUPA=9 GROUPB=hy R_0=0.17
CN5: COORDINATION GROUPA=5 GROUPB=ox R_0=0.17 
CN6: COORDINATION GROUPA=6 GROUPB=ox R_0=0.17 
CN10: COORDINATION GROUPA=10 GROUPB=ox R_0=0.17 
#NLIST NL_CUTOFF=0.5 NL_STRIDE=1000

opes: OPES_METAD ...
  ARG=dd
  TEMP=300
  PACE=100
  BARRIER=30
  STATE_WFILE=STATE
  STATE_WSTRIDE=2000*5
  STORE_STATES
  SIGMA=0.01
  USE_TOT_BIAS
...

DUAL_OPES_METAD_HIGH_LEVEL ...
  LABEL=OPESmetad_high_adjoint
  ARG=dd,(CN.*)
  TEMP=300
  PACE=100
  BARRIER=30
  BIASFACTOR=1
  PREFACTOR=-1
  NLIST  
  FILE=KernelsE2_adjoint.data
  STATE_WFILE=STATE.high.adjoint
  STATE_WSTRIDE=2000*5
  #NO_ZED
  STORE_STATES
  SIGMA=0.01,0.04,0.04,0.04,0.04,0.04,0.04
  #EXTRA_BIAS=opes.bias 
  #EXCLUDED_REGION=target
  CALL_QMPROGRAM
  USE_TOT_BIAS
... DUAL_OPES_METAD_HIGH_LEVEL

DUAL_OPES_METAD_LOW_LEVEL ...
   LABEL=OPESmetad_low_adjoint
   ARG=dd,(CN.*)
   TEMP=300
   PACE=100
   BARRIER=30
   BIASFACTOR=1
   PREFACTOR=1
   NLIST  
   FILE=KernelsE1_adjoint.data
   STATE_WFILE=STATE.low.adjoint
   STATE_WSTRIDE=2000*5
   #NO_ZED
   SIGMA=0.01,0.04,0.04,0.04,0.04,0.04,0.04
   STORE_STATES
   #EXTRA_BIAS=opes.bias
   #EXCLUDED_REGION=target
   USE_TOT_BIAS
... DUAL_OPES_METAD_LOW_LEVEL

DUAL_OPES_METAD_HIGH_LEVEL ...
  LABEL=OPESmetad_high_marginal
  ARG=dd
  TEMP=300
  PACE=100
  BARRIER=30
  BIASFACTOR=1
  PREFACTOR=1
  FILE=KernelsE2_marginal.data
  STATE_WFILE=STATE.high.marginal
  STATE_WSTRIDE=2000*5
  #NO_ZED
  SIGMA=0.01
  STORE_STATES
  #EXTRA_BIAS=opes.bias 
  #EXCLUDED_REGION=target
  USE_TOT_BIAS
... DUAL_OPES_METAD_HIGH_LEVEL

DUAL_OPES_METAD_LOW_LEVEL ...
   LABEL=OPESmetad_low_marginal
   ARG=dd
   TEMP=300
   PACE=100
   BARRIER=30
   BIASFACTOR=1
   PREFACTOR=-1
   FILE=KernelsE1_marginal.data
   STATE_WFILE=STATE.low.marginal
   STATE_WSTRIDE=2000*5
   #NO_ZED
   SIGMA=0.01
   STORE_STATES
   #EXTRA_BIAS=opes.bias
   #EXCLUDED_REGION=target
   USE_TOT_BIAS
... DUAL_OPES_METAD_LOW_LEVEL


#FLUSH STRIDE=1
PRINT STRIDE=10 ARG=d1,d2,dd,,(CN.*),uwall.bias,lwall.bias,opes.*,OPESmetad_low_adjoint.*,OPESmetad_low_marginal.*,OPESmetad_high_adjoint.*,OPESmetad_high_marginal.*,OPESmetad_high_adjoint.* FILE=colvar
ENDPLUMED
