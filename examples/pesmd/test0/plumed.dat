# setup the potential

p: DISTANCE ATOMS=1,2 COMPONENTS

#uwall: UPPER_WALLS ARG=p.x,p.y AT=1,1 KAPPA=100000.0,100000.0 EXP=2,2 EPS=1,1 OFFSET=0,0 
#lwall: LOWER_WALLS ARG=p.x,p.y AT=-1,-1 KAPPA=100000.0,100000.0 EXP=2,2 EPS=1,1 OFFSET=0,0

v1: MATHEVAL PERIODIC=NO ARG=p.x,p.y VAR=x,y ...
 FUNC=0.5*4*((x+2.5)^2+(y-2)^2)
...

v2: MATHEVAL PERIODIC=NO ARG=p.x,p.y VAR=x,y ...
 FUNC=0.5*4*((x-2.5)^2+(y-2)^2)+10
...

ene: MATHEVAL PERIODIC=NO ARG=v1,v2 VAR=x,y ...
  FUNC=0.5*(x+y)-0.5*sqrt((x-y)^2+4*15)
...

potential: BIASVALUE ARG=ene

#metad: METAD ARG=p.x SIGMA=0.2 HEIGHT=0.3 TEMP=300 BIASFACTOR=100  PACE=500 

OPES_METAD ...
  LABEL=opes
  ARG=p.x
  FILE=Kernels.data
  #STATE_RFILE=compressed.Kernels
  STATE_WFILE=compressed.Kernels
  PACE=100
  TEMP=600
  BARRIER=40
  #EXCLUDED_REGION=target
  RESTART=NO
  STATE_WSTRIDE=100*1000
... OPES_METAD

#FLUSH STRIDE=100
PRINT STRIDE=100 ARG=p.x,p.y,potential.bias,opes.bias FILE=colvar
ENDPLUMED

